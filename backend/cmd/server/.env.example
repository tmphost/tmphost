# Copy to .env and `set -a; source .env; set +a` before `go run ./cmd/server`.
TMPHOST_BASE_URL=http://localhost:5173
TMPHOST_AUTH_JWT_SECRET=change-me-to-a-long-random-string
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <TMPHOST_BASE_URL>/api/v1/auth/google/callback
TMPHOST_AUTH_GOOGLE_CLIENT_ID=
TMPHOST_AUTH_GOOGLE_CLIENT_SECRET=
# https://github.com/settings/developers
# Authorization callback URL: <TMPHOST_BASE_URL>/api/v1/auth/github/callback
TMPHOST_AUTH_GITHUB_CLIENT_ID=
TMPHOST_AUTH_GITHUB_CLIENT_SECRET=

# Unlocks /setup (generated and logged at startup when empty).
TMPHOST_AUTH_ROOT_ACCESS_TOKEN=
# Where /setup saves settings; once saved they override these env values.
# TMPHOST_SETTINGS_FILE=./_storage/settings.json
# TMPHOST_CREDITS_MONTHLY_GRANT=250

# Database: SQLite by default; set TMPHOST_POSTGRES_ENABLED=true to use PostgreSQL.
# TMPHOST_SQLITE_DSN=./_storage/tmphost.db
# TMPHOST_POSTGRES_ENABLED=true
# TMPHOST_POSTGRES_HOST=localhost
# TMPHOST_POSTGRES_PORT=5432
# TMPHOST_POSTGRES_USER=postgres
# TMPHOST_POSTGRES_PASSWORD=postgres
# TMPHOST_POSTGRES_DBNAME=tmphost
# TMPHOST_POSTGRES_SSLMODE=disable

# S3-compatible storage
# TMPHOST_S3_ENABLED=true
# TMPHOST_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# TMPHOST_S3_REGION=auto
# TMPHOST_S3_BUCKET=
# TMPHOST_S3_ACCESS_KEY_ID=
# TMPHOST_S3_SECRET_ACCESS_KEY=
# TMPHOST_S3_USE_PATH_STYLE=false
