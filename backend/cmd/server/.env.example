# Copy to .env and `set -a; source .env; set +a` before `go run ./cmd/server`.
TMPHOSTIO_BASE_URL=http://localhost:5173
TMPHOSTIO_AUTH_JWT_SECRET=change-me-to-a-long-random-string
# Required. Encrypts the settings file (AES-256-GCM). Environment only: it is
# never read from YAML. At least 32 characters, e.g. `openssl rand -hex 32`.
# Losing it means the saved settings cannot be read; re-enter them on /setup.
TMPHOSTIO_MASTER_KEY=
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <TMPHOSTIO_BASE_URL>/api/v1/auth/google/callback
TMPHOSTIO_AUTH_GOOGLE_CLIENT_ID=
TMPHOSTIO_AUTH_GOOGLE_CLIENT_SECRET=
# https://github.com/settings/developers
# Authorization callback URL: <TMPHOSTIO_BASE_URL>/api/v1/auth/github/callback
TMPHOSTIO_AUTH_GITHUB_CLIENT_ID=
TMPHOSTIO_AUTH_GITHUB_CLIENT_SECRET=

# Unlocks /setup (generated and logged at startup when empty).
TMPHOSTIO_AUTH_ROOT_ACCESS_TOKEN=
# Where /setup saves settings; once saved they override these env values.
# TMPHOSTIO_SETTINGS_FILE=./_storage/settings.json
# TMPHOSTIO_CREDITS_MONTHLY_GRANT=250
# TMPHOSTIO_CREDITS_SIGNUP_GRANT=1000

# Database: SQLite by default; set TMPHOSTIO_POSTGRES_ENABLED=true to use PostgreSQL.
# TMPHOSTIO_SQLITE_DSN=./_storage/tmphost.db
# TMPHOSTIO_POSTGRES_ENABLED=true
# TMPHOSTIO_POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/tmphost?sslmode=disable

# S3-compatible storage
# TMPHOSTIO_S3_ENABLED=true
# TMPHOSTIO_S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# TMPHOSTIO_S3_REGION=auto
# TMPHOSTIO_S3_BUCKET=
# TMPHOSTIO_S3_ACCESS_KEY_ID=
# TMPHOSTIO_S3_SECRET_ACCESS_KEY=
# TMPHOSTIO_S3_USE_PATH_STYLE=false
